# Copy to bridge/.env and fill in. Nothing here is committed.

# Jev (TypeSafe System One) sorts every save. Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# Folder holding your vault (a git repo with GitHub Pages turned on). Defaults to ~/articles
# BRAIN_VAULT_DIR=~/brain-vault

# Port the extension talks to. Change it in background.js and sidepanel.js too if you do.
# BRAIN_VAULT_PORT=5128
